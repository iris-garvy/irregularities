          "r18",
          "r19"
        ]
      },
      {
        "finding": "Exact-match accuracy is at floor on arithmetic and near ceiling on copying for GPT-2 small, while log-probability stays graded.",
        "proposed_claim": "Binary accuracy is censored at floor and coarse near ceiling for head-ablation evaluation; log-probability remains informative.",
        "row_ids": [
          "r5",
          "r6",
          "r7",
          "r8",
          "r20",
          "r21",
          "r22",
          "r23"
        ]
      },
      {
        "finding": "Discovery-selected heads beat random and layer-matched held-out controls in both models (p=0.001). GPT-2 task-specificity is not robust (p=0.078, then 0.274 at N=500), while DistilGPT2 specificity has p=0.001.",
        "proposed_claim": "Matched held-out controls separate selected-head effects from arbitrary disruption, but task-specificity of the selected heads varies by model and run.",
