    "title": "From Latents to Labels: Zero-Shot Named Entity Recognition using Sparse Autoencoder Features",
    "citation": "Nakanyseth Vuth et al., 2026",
    "url": "https://www.semanticscholar.org/paper/a4cc4dd23db62af648b7d87da3f1615e70e962cd",
    "authors": "Nakanyseth Vuth; Gilles Sérasset; Didier Schwab",
    "year": "2026",
