  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "cites_only",
    "tranche": "T6",
    "tranche_reason": "The study measures pre-generation decodability of code correctness, not feature overlap, polysemanticity, SAE feature recovery, or the geometry of superposed features.",
    "gate_note": "The reported probe and baseline results concern correctness prediction, a related but different representation question. They do not measure any version of the superposition claim, so the rows are recorded with versions [\"none\"]. The repair analysis could not estimate a repair direction and does not measure superposition geometry.",
    "test_reason": "The study probes whether first-attempt code correctness is linearly decodable from Qwen3-4B prompt-final hidden states. It never mentions superposition, polysemanticity, sparse autoencoders or feature geometry. It does not cite Toy Models of Superposition. None of its results bear on any version. 'discusses' overstates the link, and no enum value covers 'not mentioned at all', so cites_only is used as the weakest available relation.",
    "authors_conclusion": "The record's paraphrase is accurate. Correctness is linearly decodable before generation (0.881 AUC) and survives prompt-length residualization (0.842 vs a 0.657 baseline). The repair-geometry question could not be answered because only 14 tasks recovered at the first repair.",
    "recipe": "none",
    "recipe_differences": "The study uses nested-CV linear probing and prompt-length residualization for correctness prediction; it does not apply the original superposition method.",
    "method_sensitivity": "Probe performance varies slightly across captured layers; layer selection is nested-CV. Residualizing against prompt length lowers AUC from 0.881 to 0.842, while the prompt-length-only baselines are lower.",
    "fits_no_version": [
      {
        "finding": "First-attempt correctness is linearly decodable from prompt-final hidden states before generation. Nested-CV AUC is 0.881, and 0.842 after residualizing against prompt length.",
        "proposed_claim": "A frozen Qwen3-4B-Instruct-2507's prompt-final hidden state linearly encodes whether its first code attempt will pass the unit tests.",
        "row_ids": [
          "r1",
          "r2"
        ]
      },
      {
        "finding": "Prompt length alone predicts correctness above chance (AUC 0.642–0.657). Nonlinear models on prompt length do not beat the logistic baseline.",
        "proposed_claim": "Prompt length is a partial confound for pre-generation correctness probes but does not explain most of the probe signal.",
        "row_ids": [
          "r3",
          "r4",
          "r5",
          "r6"
        ]
      },
      {
        "finding": "Per-layer test AUC is a flat plateau of 0.880–0.884 across layers 29–36, peaking at layer 30.",
        "proposed_claim": "Pre-generation correctness decodability is roughly constant across the upper layers of this model.",
        "row_ids": [
          "r7",
          "r8",
          "r9",
          "r10",
          "r11",
          "r12",
          "r13",
          "r14"
        ]
      }
    ],
