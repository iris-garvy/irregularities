  "record": {
    "read_status": "full",
    "file_problem": "none noted",
    "relation": "cites_only",
    "tranche": "T6",
    "tranche_reason": "The study evaluates safety of mobile-device-control agents, not fine-tuning effects, response-position KL, opening-token bypasses, localized safety parameters, or safety-deepening training. Its indirect prompt-injection tests are a different setting and do not test the claim versions.",
    "gate_note": "The paper reports mobile-agent task outcomes and prompt-injection defenses. These concern a related but different construct from the claim versions; they do not test fine-tuning, first-token concentration, compliant prefilling, suffix or decoding bypasses, parameter localization, or training to deepen safety.",
    "test_reason": "This is a benchmark of prompted LLM agents controlling Android devices. There is no fine-tuning (harmful or benign), no per-token KL, no prefill, suffix or decoding attack, no parameter localization, and no deepening training. The indirect prompt injections are instructions placed in UI observations, not compliant-opening bypasses of refusal. Qi et al. 2024, an original source, is cited only in related work. Refusal rates of prompted agents on risky tasks are a related but different construct, so they are recorded under fits_no_version.",
    "authors_conclusion": "Correct. The authors also report that OpenAI-o1 agents refuse more often (61% basic, 86% SCoT on high-risk tasks) but with about 4x latency, and remain vulnerable to injection (2/10 defenses).",
    "recipe": "none",
    "recipe_differences": "The paper benchmarks mobile-device agents and evaluates safety-oriented prompts; it does not reproduce or adapt the original fine-tuning or token-depth methods.",
    "method_sensitivity": "Prompt type changes mobile-agent outcomes: the GPT-4o SCoT prompt has a higher reported refusal rate than the basic prompt. The paper also reports different outcomes across models and between QA and agentic settings.",
    "fits_no_version": [
      {
        "finding": "Prompted agents often complete high-risk mobile tasks. GPT-4o (SCoT) achieved 60% of high-risk goals with a 31% refusal rate, and no agent exceeded 70% refusal on high-risk tasks.",
        "proposed_claim": "Mobile-device-control agents built on safety-trained LLMs often carry out harmful actions in everyday high-risk tasks, with outcomes varying by model.",
        "row_ids": [
          "r1",
          "r2",
          "r3",
          "r4",
          "r5",
          "r6",
          "r7",
          "r8"
        ]
      },
      {
        "finding": "Agents defended against few indirect prompt injections: 3/50 for GPT-4o, 8/50 for Gemini-1.5 and 15/50 for Claude-3.5.",
        "proposed_claim": "Mobile-device-control agents are highly vulnerable to indirect prompt injection embedded in messages or posts.",
        "row_ids": [
          "r9",
          "r10",
          "r11"
        ]
      },
      {
        "finding": "With the SCoT prompt, GPT-4o's high-risk refusal rose from 6% to 36%, while low-risk goal achievement moved from 84% to 82%.",
        "proposed_claim": "Requiring explicit safety considerations in an agent prompt raises refusal on high-risk tasks with little loss of capability.",
        "row_ids": [
          "r12",
          "r13",
          "r14",
          "r15"
        ]
      },
      {
        "finding": "Models detected risks in a QA format far more often than they handled them as agents (GPT-4o 92% vs 36%; Claude 92% vs 66%).",
        "proposed_claim": "Risk recognition in question-answering does not reliably carry over to safe actions by agents.",
        "row_ids": [
          "r16",
          "r17",
          "r18",
          "r19",
          "r20",
          "r21"
        ]
      }
    ],
