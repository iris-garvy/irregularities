  "record": {
    "read_status": "full",
    "file_problem": "not stated",
    "relation": "tests",
    "tranche": "T3",
    "tranche_reason": "Tests whether benign, domain-specific medical fine-tuning degrades safety using safety-benchmark outcomes and an explicit comparison with the base model; it does not reproduce the original fine-tuning recipe.",
    "gate_note": "The paper reports that medical fine-tuning uses benign data and degrades safety relative to the base model, but gives no numerical base-model safety scores for that comparison. Table 1 separately reports safety scores for the original medically fine-tuned models. The unalignment step is used to construct a safety vector; the paper does not report it as a test of harmful fine-tuning removing refusal. Results for the paper's safety-grafting method are not evidence about the listed claim versions concerning token-position concentration, bypasses, localization, or deepening.",
    "test_reason": "The paper reports that benign medical fine-tuning of an MLLM (Lingshu-7B from Qwen2.5-VL-7B) lowered general and medical safety scores relative to its base model. This bears on V2 in a new setting: multimodal medical models. The comparison is qualitative and uses third-party released checkpoints, not a controlled fine-tuning run. The unalignment step and safety grafting are method components, not tests of V1, V5 or V7.",
    "authors_conclusion": "Correct. The authors conclude that medical fine-tuning often causes catastrophic forgetting of safety alignment, that medical MLLMs are especially weak to cross-modal jailbreaks, and that their parameter-space safety grafting restores safety with little loss of medical accuracy.",
    "recipe": "different",
    "recipe_differences": "Evaluates safety following medical-domain fine-tuning of MLLMs, rather than fine-tuning with the original study's harmful or ordinary benign instruction examples; no matching example count or recipe is stated.",
    "method_sensitivity": "For the paper's safety-grafting method, layer-wise versus model-wise optimization changes safety scores; layer-wise is generally reported as stronger, with some medical-performance trade-offs.",
    "fits_no_version": [
      {
        "finding": "Cross-modality typographic jailbreak (FigStep) sharply lowers safety of the medical MLLMs. Lingshu-7B falls from 0.4750 to 0.2375 on HarmBench and from 0.6022 to 0.3467 on MedSafetyBench.",
        "proposed_claim": "Visual/typographic jailbreaks bypass refusal in fine-tuned MLLMs (input-side attack, not prefill/suffix/decoding as in V4).",
        "row_ids": [
          "r3",
          "r4",
          "r11",
          "r12"
        ]
      }
    ],
    "controls": "y",
    "capability_check": "y",
    "uncertainty_reported": "y",
    "code_released": "not stated",
    "peer_reviewed": "preprint",
    "problems": "The base-model safety scores and numerical fine-tuning deltas are not reported for the explicit degradation comparison. Safety scores are judged using LLM-as-a-Judge; uncertainty is not reported for the original-model scores in Table 1.",
    "rows_left_out": "No rows omitted from the reported original-model safety scores relevant to V2.",
    "untested": [
