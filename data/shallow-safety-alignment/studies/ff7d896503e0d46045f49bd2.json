  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "uses_without_test",
    "tranche": "T4",
    "tranche_reason": "The study uses refusal-vector ablation as a tool for assessing agentic misuse and reports its performance, but does not test the claim versions about fine-tuning, token-position KL, bypassing the response opening, parameter localization, shallowness, or deepening.",
    "gate_note": "The study reports its own chat and agent task outcomes, including results before and after refusal-vector ablation. It does not report results for the cited fine-tuning study, and the ablation and agent scaffold are not tests of the listed token-opening or fine-tuning claims.",
    "test_reason": "The study uses refusal-vector ablation (Arditi et al.) as a tool and reports harmful and benign agent task counts for its own setup. It does no fine-tuning (V1, V2), no per-token KL (V3), no prefill, suffix or decoding attack (V4), and no training changes (V6, V7). The rank-1 refusal-direction edit is borrowed from Arditi et al. and is not tested against alternatives, so it is not a test of V5. The chat-versus-agent gap is a related but different construct.",
    "authors_conclusion": "Correct. The authors conclude that refusal-vector ablation generalizes to agentic misuse, and that the unablated Llama 3.1 agents already do most harmful tasks while refusing the same requests in chat. They argue that chat safety fine-tuning does not generalize to agentic misuse, and they propose ablated-model evaluation as a standard risk test.",
    "recipe": "different",
    "recipe_differences": "The study applies refusal-vector ablation and evaluates tool-using agents; it does not perform the fine-tuning or token-position measurements described in the original claim sources.",
    "method_sensitivity": "The study compares agent task outcomes with and without refusal-vector ablation, and reports chat versus agent results. It uses the same system prompt for the chat completions and agents.",
    "fits_no_version": [
      {
        "finding": "With the same system prompt, 405B, 70B and 8B refuse all 28 harmful requests in chat. In agent mode, 70B and 8B complete 18 of 28 harmful tasks with 7 and 3 refusals respectively.",
        "proposed_claim": "Chat-mode refusal training does not generalize to tool-using agentic execution of the same harmful tasks.",
        "row_ids": [
          "R1",
          "R3",
          "R5",
          "R7",
          "R9",
          "R10",
          "R11"
        ]
      },
      {
        "finding": "Refusal-direction ablation raises harmful agent task success from 18 to 26 of 28, with 0 refusals, for both 70B and 8B.",
        "proposed_claim": "Refusal-direction ablation (rank-1 weight edit) removes refusals in agentic harmful tasks.",
        "row_ids": [
          "R2",
          "R4",
          "R6",
          "R8"
        ]
      },
      {
        "finding": "Benign agent task success falls slightly after ablation (70B 21 to 19; 8B 22 to 19); the authors call this not significant.",
        "proposed_claim": "Refusal-direction ablation has small capability cost on agentic benign tasks.",
        "row_ids": [
          "R12",
          "R13",
          "R14",
          "R15",
          "R16",
          "R17",
