        ]
      }
    ],
    "controls": "y",
    "capability_check": "y",
    "uncertainty_reported": "n",
    "code_released": "https://github.com/DalasNoin/safety_benchmarks",
    "peer_reviewed": "preprint",
    "problems": "The authors describe the benchmark as small and say some tasks rely on self-evaluation; they note that models may have refused during intermediate conversation steps because only final outputs were checked. No statistical uncertainty is reported for the tabulated counts.",
    "rows_left_out": "none",
