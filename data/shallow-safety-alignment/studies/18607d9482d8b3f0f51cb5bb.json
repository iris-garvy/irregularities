    "missing": [
      {
        "what": "Per-model HADES safety scores and the Utility Score are described but never reported in any table.",
        "locator": "Section 3(i); Appendix A.6; Figure 2",
        "versions": "V2"
      }
    ],
    "verdict_notes": "HADES is originally a multimodal jailbreak benchmark; the paper appears to use its text prompts only. DeepSeek-R1-Distill-Qwen models are reportedly distilled from Qwen2.5-Math bases rather than from the instruct models used as baselines, which weakens the V2 inference. Machine-ethics jailbreak refusal and OOD refusal are not harmful-request compliance and are correctly excluded."
  },
