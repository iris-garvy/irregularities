  "record": {
    "read_status": "full",
    "file_problem": "none noted",
    "relation": "cites_only",
    "tranche": "T6",
    "tranche_reason": "Tests whether adversarial prompt reframing can elicit harmful responses despite safety refusals, using a different attack method from the claim’s fine-tuning and first-token mechanisms.",
    "gate_note": "The paper tests iterative semantic reframing, not fine-tuning, token-position KL, compliant-opening prefills, suffixes, decoding changes, localized weights, or safety-deepening training. The safety-score values in Table 1 are used to guide the attack, not reported as harmful-completion rates. Table 5–6 results report the attack’s own success rates; comparative baseline-method numbers are not included as separate rows.",
    "test_reason": "This paper presents a black-box jailbreak method (THREAT) that iteratively rewrites a harmful prompt in softer words. It reports refusal rates and attack success rates for its own method. It does not fine-tune any model (V1, V2) or measure per-token KL (V3). It uses no prefill, suffix or decoding change (V4), studies no weights (V5), gives no causal account (V6) and trains no deeper safety (V7). Rewording the user prompt is not getting past the response opening, so no row bears on V4. The paper only cites the original fine-tuning source (ref 41) in its related work. The GCG suffix numbers in Table 5 follow [43] and appear to be cited baseline results, not the study's own measurements.",
    "authors_conclusion": "The record's paraphrase is correct. The authors conclude that THREAT's iterative reframing finds prompts that evade safety filters while preserving harmful intent. They report that it beats prior jailbreak methods in reducing refusals, at lower computational cost.",
    "recipe": "different",
    "recipe_differences": "The study uses iterative LLM-guided semantic reframing and risk-based prompt selection. It does not fine-tune models or measure response-token positions.",
    "method_sensitivity": "Refusal counts change with the safe-function model and generator choice; the paper reports higher refusal counts when gpt-5 replaces gpt-4o in the safe-function or engine roles, and a ∼5% refusal rate with Gemini 2.5 Flash as engine under a fixed gpt-5 safe function. The two judge rubrics also yield different attack-success rates.",
    "fits_no_version": [
      {
        "finding": "Iteratively reworded prompts cut GPT-4o refusals from about 37–61% to about 1% or less (R1–R10). They reach 54–76% HarmBench attack success rate on open 7–8B models, including circuit-breaker (RR) models (R16–R25).",
        "proposed_claim": "Semantic rewording of harmful prompts elicits compliance from safety-trained models that refuse the original prompts.",
