        ]
      }
    ],
    "controls": "y",
    "capability_check": "y",
    "uncertainty_reported": "n",
    "code_released": "The authors state they will release the training framework and fine-tuned models in the near future; no release URL is stated.",
    "peer_reviewed": "Computer Vision and Pattern Recognition (2025)",
    "problems": "No error bars or uncertainty estimates are reported for these ASR values. Harmfulness is judged by gpt-4-turbo, and the text-attack evaluation uses the first 100 AdvBench prompts.",
    "rows_left_out": "Omitted ImgJP, VAA, FigStep, and MM-SafetyBench rows because these use image or image-text attacks rather than the suffix/string attacks this record links to V4. Their results are in Section 5.1, Table 1.",
