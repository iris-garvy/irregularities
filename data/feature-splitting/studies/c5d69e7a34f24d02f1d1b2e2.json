  "page_placements": [],
  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "discusses",
    "tranche": "T6",
    "tranche_reason": "The paper reports SAE scaling and paraphrase-sensitivity results, but it does not test feature splitting, correspondence between latents at different dictionary sizes, or whether split features partition a parent’s inputs.",
    "gate_note": "The paper cites work on feature splitting and canonical units in its background, but reports no results from those studies. Its own measurements concern feature activation sensitivity under paraphrases and TopK selection-boundary margins; these are related to SAE reliability but do not test any listed version of the splitting claim.",
    "test_reason": "The study measures paraphrase sensitivity of TopK SAE features and TopK margins across width and k. It never checks whether coarse latents split into finer ones, how latents correspond across dictionary sizes, absorption, hierarchy, or Matryoshka objectives. Feature splitting and canonical units are cited only in background. No version is tested.",
    "authors_conclusion": "Correct. One addition: the authors also show the margin pattern on a public JumpReLU Gemma Scope SAE and argue the boundary account extends beyond TopK.",
    "recipe": "none",
    "recipe_differences": "The study trains and evaluates TopK SAEs for paraphrase sensitivity and does not apply a feature-splitting measurement recipe.",
    "method_sensitivity": "Rare-feature sensitivity and boundary crowding vary with active budget; outcomes also vary across model family, depth, token budget, and intervention.",
    "fits_no_version": [
      {
        "finding": "In GPT-2 L8 TopK SAEs, rare-feature paraphrase sensitivity falls along the joint width/k path (0.650→0.585 at 10M tokens). The width×k factorial attributes the fall to k (−14.8pp) rather than width (1.9pp span).",
        "proposed_claim": "Raising the TopK active budget lowers rare-feature paraphrase stability while improving reconstruction; width alone has little effect.",
        "row_ids": [
          "r1",
          "r2",
          "r3",
          "r4",
          "r5",
          "r6",
          "r7",
          "r8",
          "r9",
          "r10",
          "r11",
          "r12"
        ]
      },
      {
        "finding": "Active margin to the TopK cutoff predicts paraphrase dropout. AUROC is 0.728 at layer 8 and 0.747–0.850 at other depths. Flip rate falls from 0.941 to 0.006 across margin bins, and a similar pattern appears for a Gemma Scope JumpReLU SAE.",
        "proposed_claim": "SAE features close to their selection boundary are the ones most likely to drop out under paraphrase.",
        "row_ids": [
          "r13",
          "r14",
          "r15"
        ]
      },
      {
        "finding": "Pairwise rank stabilization raises held-out rare sensitivity by +8.83pp in GPT-2, +1.7pp in Qwen and −0.8pp in Gemma.",
        "proposed_claim": "A boundary-ordering loss can improve paraphrase stability of TopK SAE features, depending on model.",
        "row_ids": [
          "r16",
          "r17",
          "r18"
        ]
      }
    ],
    "controls": "y",
    "capability_check": "n",
    "uncertainty_reported": "y",
    "code_released": "not stated",
    "peer_reviewed": "preprint",
    "problems": "The main GPT-2 evaluation collection has 148 pairs; the authors describe the layer-8 AUROC anchor as a single-seed estimate. The paper itself notes that paraphrase sensitivity is not a semantic oracle and does not establish whether dropped features correspond to lost human-interpretable concepts. No evidence in the study addresses feature splitting.",
    "rows_left_out": "No splitting-related outcomes were reported. Other sensitivity-repair comparisons, token-budget summaries, and auxiliary metrics were omitted because they do not measure feature splitting and are not needed to represent the distinct sensitivity and margin findings recorded here.",
    "untested": [
      {
        "version": "V1",
        "parts": "Coarse-to-fine replacement of latents with dictionary growth, input coverage, direction similarity: none measured."
      },
      {
        "version": "V2",
        "parts": "Splitting in large models or open SAE releases: Gemma/Qwen and Gemma Scope are used only for sensitivity/margin checks."
      },
      {
        "version": "V3",
        "parts": "Nested, geometrically close feature families mirroring a concept hierarchy."
      },
      {
        "version": "V4",
        "parts": "Parent latents failing to fire where children take over; whether size or sparsity fixes it."
      },
      {
        "version": "V5",
        "parts": "Decomposition of larger-SAE latents into smaller-SAE latents; novel latents; canonical units."
      },
      {
        "version": "V6",
        "parts": "Whether splitting is an artifact of the sparsity objective; Matryoshka or other objectives' effect on splitting."
      }
    ],
    "missing": [],
    "verdict_notes": "Width is varied in this study, but the measure is activation stability under paraphrase, not latent splitting. No row bears on any version, so no verdicts are given."
  },
