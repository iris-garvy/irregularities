  "record": {
    "read_status": "full",
    "file_problem": "not stated",
    "relation": "tests",
    "tranche": "T1",
    "tranche_reason": "Compares held-out performance of adaptive optimizers with SGD across image and language tasks, bearing on V4 with a different optimizer and experimental setup.",
    "gate_note": "Results cited from Wilson et al. and other prior work are not extracted. The paper reports test accuracies and training/validation behavior, but does not test random-label memorization or measure a training–test error gap directly.",
    "test_reason": "The study directly compares adaptive optimizers with scheduled momentum SGD using held-out classification accuracy, the same experimental method and measure underlying V4. Its baseline comparisons test V4 independently of its proposed DFW method.",
    "authors_conclusion": "The paraphrase is broadly accurate: the authors conclude that DFW predominantly outperforms adaptive gradient baselines and achieves performance similar to scheduled SGD without a hand-designed schedule. They suggest that maintaining high early learning rates contributes to generalization; this is an interpretation, not an isolated causal finding. Their augmented CIFAR results also show DFW consistently below SGD.",
    "recipe": "different",
    "recipe_differences": "Introduces Deep Frank-Wolfe and compares its test accuracy with adaptive methods and scheduled SGD; losses differ across methods in the CIFAR experiments (SVM for DFW, cross-entropy for baselines).",
    "method_sensitivity": "Initial learning rate affects validation performance; DFW's response to large η depends on batch size, and the paper reports that recurrent models show less distinct learning-rate effects.",
    "fits_no_version": [
      {
        "finding": "Reducing SGD's initial learning rate tenfold while increasing training tenfold lowers the training objective from 0.33 to 0.069 but lowers best validation accuracy from 70.94% to 68.7%.",
        "proposed_claim": "More accurate optimization can accompany worse generalization when the learning-rate and training-duration recipe changes.",
        "row_ids": [
          "R17"
        ]
      },
      {
        "finding": "DFW with batch size 256 and η = 1 reaches 72.64% test accuracy, compared with 70.33% for the standard SGD recipe.",
        "proposed_claim": "A jointly changed optimizer, batch size, and step-size recipe can outperform the standard SGD recipe on DN/CIFAR-100.",
        "row_ids": [
          "R18"
        ]
      }
    ],
    "controls": "n",
    "capability_check": "n",
    "uncertainty_reported": "n",
    "code_released": "https://github.com/oval-group/dfw",
    "peer_reviewed": "International Conference on Learning Representations (ICLR 2019)",
    "problems": "Optimizer comparisons do not consistently hold loss constant: CIFAR DFW uses SVM while baselines use cross-entropy. No uncertainty estimates are reported. The section 6.2 DFW/S GD comparison changes optimizer, batch size, and learning-rate procedure together.",
    "rows_left_out": "None of the reported Table 2 augmented CIFAR comparisons or Table 3 SNLI comparisons are extracted; Table 1 and the section 6.1–6.2 results provide the selected V4 comparisons. No isolated batch-size comparison is extracted because the text does not report a controlled batch-only test of V5.",
    "untested": [
      {
        "version": "V1",
        "parts": "Random-label fitting and its coexistence with natural-label generalization."
      },
      {
        "version": "V2",
        "parts": "Width increases beyond the width required for zero training error."
      },
      {
        "version": "V3",
        "parts": "Convolutional versus fully connected architectures and local connectivity."
      },
      {
        "version": "V4",
        "parts": "Comprehensive optimizer tuning, decoupled weight decay, switching Adam to SGD, and word-level language modeling. R1–R16 alone do not establish equal or better training performance for adaptive methods."
      },
      {
        "version": "V5",
        "parts": "A batch-size penalty beyond a workload-dependent threshold and its removal by an adapted recipe. Appendix batch-size grids are hyperparameter-selection results, not a dedicated threshold comparison."
      },
      {
        "version": "V6",
        "parts": "Dropout effects and interactions with training-set size, augmentation, or weight decay."
      },
      {
        "version": "V7",
        "parts": "Magnitude-aware sharpness and its ranking of generalization gaps."
      },
      {
        "version": "V8",
        "parts": "Removal of memorized training examples versus random removal."
      }
    ],
    "missing": [],
    "verdict_notes": "R1–R16 compare baselines all trained with cross-entropy, so DFW's different loss does not confound these verdicts. Adaptive initial learning rates were selected on validation data; WRN additionally allowed two regularization values, so tuning was limited but not exclusively learning-rate tuning. Table 2 and Table 3 results are explicitly declared in rows_left_out and therefore are not listed as missing. No uncertainty estimates accompany the extracted test accuracies."
