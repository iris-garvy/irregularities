  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "cites_only",
    "tranche": "T6",
    "tranche_reason": "Tests whether changing Adam’s update rule changes held-out performance, using a different optimizer intervention and measure from the listed versions.",
    "gate_note": "Reports test accuracy, test perplexity, and mAP for EAdam and other adaptive optimizers. It does not compare with SGD or momentum SGD, random labels, or the other conditions named in V1–V8.",
    "test_reason": "The study cites Wilson et al. for Adam generalizing worse than SGD, but its experiments compare only adaptive optimizers. EAdam-versus-Adam performance does not test V4's adaptive-versus-SGD comparison or its specified remedies. No experiment tests V1–V3 or V5–V8.",
    "authors_conclusion": "The record's paraphrase is accurate: the authors conclude that EAdam's change to epsilon improves or approximately matches Adam across the tested tasks. They provide intuitive explanations but acknowledge that the reason for the advantage remains unresolved and that larger-scale tasks require verification.",
    "recipe": "different",
    "recipe_differences": "Changes Adam’s ε update; compares EAdam with Adam, RAdam, and Adabelief across image classification, language modeling, and object detection.",
    "method_sensitivity": "Results vary by task, dataset, and model; the authors also vary learning-rate and ε values in the language-modeling experiments.",
    "fits_no_version": [
      {
        "finding": "EAdam improves CIFAR test accuracy over Adam in all six comparisons and improves VOC mAP from 71.47 to 80.62. On Penn Treebank, perplexity is approximately unchanged for one layer (84.46 versus 84.42) and lower for two and three layers (66.32 versus 67.36; 61.13 versus 64.29).",
        "proposed_claim": "Changing the placement and accumulation of epsilon in Adam can improve held-out performance in these tested settings.",
