  "record": {
    "read_status": "full",
    "file_problem": "not stated",
    "relation": "tests",
    "tranche": "T3",
    "tranche_reason": "Compares adaptive and non-adaptive optimizers on a financial time-series forecasting task and reports training and test errors.",
    "gate_note": "The paper evaluates LSTM forecasting errors, not classification generalization on natural labels. Its ATR-based switching method is included as a benchmark; no results on random labels, width sweeps, convolutional versus fully connected networks, dropout ablations, sharpness, or memorized-example removal are reported.",
    "test_reason": "The single-optimizer baselines compare adaptive methods with SGD using held-out prediction error in a new setting: financial time-series forecasting. This bears on V4's optimizer comparison, although it does not directly test its image/language benchmarks or restricted tuning protocol.",
    "authors_conclusion": "The record accurately paraphrases the authors' conclusion: ATR-based optimizer switching improves KLCI forecasting accuracy relative to the three single-optimizer LSTMs. The reported evidence is one chronological split without uncertainty estimates.",
    "recipe": "different",
    "recipe_differences": "Financial time-series forecasting with LSTMs and ATR-driven optimizer switching; reports MAE and RMSE rather than classification error or a train-test generalization gap.",
    "method_sensitivity": "Optimizer choice and training versus testing split show different forecast errors.",
    "fits_no_version": [
      {
        "finding": "ATR Dynamic LSTM achieves training MAE/RMSE of 9.02/12.17 and test MAE/RMSE of 8.25/11.66, the lowest reported values.",
        "proposed_claim": "Volatility-driven optimizer switching improves KLCI forecasting error relative to the three tested single-optimizer LSTMs.",
        "row_ids": [
          "R13",
          "R14",
          "R15",
          "R16"
        ]
      }
    ],
    "controls": "y",
    "capability_check": "n",
