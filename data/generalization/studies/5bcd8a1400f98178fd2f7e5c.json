    "title": "PoF: Post-Training of Feature Extractor for Improving Generalization",
    "citation": "Ikuro Sato et al., 2022",
    "url": "https://arxiv.org/abs/2207.01847",
    "authors": "Ikuro Sato; Ryota Yamada; Masayuki Tanaka; Nakamasa Inoue; R. Kawakami",
    "year": "2022",
