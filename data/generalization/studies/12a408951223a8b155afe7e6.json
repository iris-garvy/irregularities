  "record": {
    "read_status": "full",
    "file_problem": "none; full paper text supplied",
    "relation": "discusses",
    "tranche": "T6",
    "tranche_reason": "The study measures whether layer-wise distortion and SVM complexity correlate with held-out test accuracy, using a different method from the claim versions.",
    "gate_note": "The paper reports R² correlations between distortion measures and trainset or testset accuracy for Task-1 and Task-2 models. The four representative models’ test accuracies are stated, but their individual distortion values are only shown in figures.",
    "test_reason": "The study evaluates feature-distortion and support-vector-count predictors of accuracy, which none of V1–V8 names. It does not measure magnitude-aware weight sharpness or compare its ranking with other measures as V7 requires. Citing V7's original source does not test that version.",
    "authors_conclusion": "The record's paraphrase is accurate. The authors conclude that simple layer-wise regularity measures predict generalization in the evaluated VGG-like and Network-in-network models. Support-vector count has the strongest reported test-accuracy correlation among their measures in both tasks. Their conclusion also asserts independence from training strategy; the reported aggregate correlations do not separately establish that assertion.",
    "recipe": "different",
    "recipe_differences": "Measures layer-wise feature distortion and SVM support-vector complexity to predict accuracy; it does not reproduce the interventions or measurements in the claim versions.",
    "method_sensitivity": "The reported correlations differ by task and distortion measure; GMM is weaker than SVM and #SVs for test accuracy.",
    "fits_no_version": [
      {
        "finding": "Across the two public PGDL model sets, support-vector count has the highest reported test-accuracy R² among the evaluated measures: 0.93 and 0.98. Feature, GMM, and SVM distortion also correlate with test accuracy to varying degrees; training-accuracy correlations are reported separately.",
        "proposed_claim": "Layer-wise feature-distortion measures and support-vector counts can predict held-out accuracy across trained image classifiers with comparable training performance.",
