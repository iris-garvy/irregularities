    "peer_reviewed": "Computer Vision and Pattern Recognition (as stated in source metadata)",
    "problems": "Does not report training error alongside test accuracy, so the training–test gap cannot be evaluated directly. Experiments are transfer-learning tasks with ImageNet-pretrained networks except the supplementary scratch experiments; they do not test random labels or broad natural-label training from scratch. Most listed numerical comparisons report accuracy without uncertainty; Table 1 reports standard deviations.",
    "rows_left_out": "Cited comparator methods are not included as this paper's own results. No separate new row was needed for the validation prediction certainty and entropy analysis because those measures do not report held-out classification accuracy or the training–test gap.",
    "untested": [
      {
        "version": "V1",
        "parts": "Fixed-random-label fitting, chance-level random-label test accuracy, and coexistence with natural-label generalization under the same recipe."
      },
      {
        "version": "V2",
        "parts": "Width sweeps beyond the width required for zero training error."
      },
      {
        "version": "V3",
        "parts": "Convolutional versus fully connected architectures and the contribution of local connectivity."
      },
      {
        "version": "V4",
        "parts": "Adaptive optimizer versus SGD comparisons and tuning-dependent differences."
      },
      {
        "version": "V5",
        "parts": "Batch-size comparisons under fixed epoch budgets and recipe adaptations. Changing batch size between datasets supplies no controlled comparison."
      },
      {
        "version": "V6",
        "parts": "Dropout addition, removal, strength, training-set-size dependence, and joint removal with weight decay. VGG dropout remains fixed at 0.5."
      },
      {
        "version": "V7",
        "parts": "Magnitude-aware sharpness measurements, generalization-gap rankings, and comparisons with norm- and margin-based measures."
      },
      {
        "version": "V8",
        "parts": "Memorization-based example selection, removal, retraining, and comparison with random removal."
      }
