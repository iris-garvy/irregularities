  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "discusses",
    "tranche": "T6",
    "tranche_reason": "Tests SWA on vehicle image classification and reports held-out accuracy for natural labels; this is an extension to a new model/task setting, not a test of random-label memorization or the listed gap conditions.",
    "gate_note": "Reports Stanford Cars and Craigslist test accuracy for SGD/SWA training and learning-rate settings. Random-label fit and training error are not reported, so these results do not directly measure the training-test gap. Cited findings about SWA and flat minima are not this study's own results.",
    "test_reason": "The study evaluates SWA and learning-rate schedules on vehicle recognition, which tests none of V1–V8. Its discussion of flat minima supplies motivation, but it measures neither magnitude-aware sharpness nor generalization gaps. The abstract mentions random labels without reporting a random-label experiment.",
    "authors_conclusion": "The record captures the authors' main accuracy claim but omits their claims of reduced computation time and roughly one percentage point improvement from cyclic training. Those claims lack timing results and clear matched comparisons. Their reported 84.2 on Stanford Cars rounds Table 1's 84.21; Craigslist's 82.98 comes from the fixed-rate 0.0002 setting, not the favored cyclic pair. The pair (0.02, 0.0002) is best among cyclic settings for Resnet-50 and Resnet-102, but Resnet-101 does best with (0.03, 0.0003).",
    "recipe": "different",
    "recipe_differences": "Applies SWA weight averaging with SGD and learning-rate schedule variations to vehicle recognition; does not use the original claim's random-label memorization setup or measure train-test gaps.",
    "method_sensitivity": "Reported accuracy varies with SWA learning rate, fixed versus cyclic schedule, and Resnet model; the authors state cyclic learning-rate pair choice affects results.",
    "fits_no_version": [
      {
        "finding": "On Stanford Cars, SWA+SGD accuracy ranges from 83.62 to 84.21 versus 83.16 for SGD at 20 epochs. Craigslist AP varies with model and learning-rate schedule, without an SGD-only comparator.",
        "proposed_claim": "SWA can improve reported vehicle-classification performance over SGD in the tested Stanford Cars setting; its performance varies with learning-rate settings and model.",
