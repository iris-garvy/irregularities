      {
        "finding": "In synthetic linear regression, narrow fine-tuning most damages performance on tasks near, but outside, the fine-tuning distribution. Code fine-tuning lowers English XNLI accuracy by 8.36% but barely changes it in other languages.",
        "proposed_claim": "Narrow fine-tuning shifts implicit task inference beyond its distribution. This concerns capability, not alignment.",
        "row_ids": []
      }
    ],
    "controls": "y",
    "capability_check": "n",
