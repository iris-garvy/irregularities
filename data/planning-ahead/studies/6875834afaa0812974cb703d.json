    "controls": "y",
    "capability_check": "n",
    "uncertainty_reported": "y",
    "code_released": "not stated",
    "peer_reviewed": "preprint",
    "problems": "The study evaluates two generator families and hidden states from a single layer. The balanced benchmark confidence intervals capture evaluation-row sampling variability, not retraining or seed variability. Prompt-trigger results depend on source-side threshold calibration and use a system prompt instructing direct answers without refusal or safety disclaimers. The experiments do not test token-level future representations or causal steering of intervening text.",
    "rows_left_out": "No rows left out from the selected relevant results. External-guard comparisons, latency measurements, and EMA sensitivity results were omitted because they report guard comparison or runtime behavior rather than testing future-token representation or its causal effect on text.",
    "untested": [
      {
        "version": "V1",
        "parts": "No rhyming verse, no frontier-model attribution, no intervention on rhyme candidates."
      },
      {
        "version": "V2",
        "parts": "No decoding of token identities several positions ahead; the hazard head predicts only a binary harmful-onset-within-16-tokens label."
      },
      {
        "version": "V3",
        "parts": "No test separating features computed for later positions from next-token side effects."
      },
      {
