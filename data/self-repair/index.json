    {
      "title": "Later components damp earlier contributions",
      "summary": "Evidence of counterbalancing during ordinary forward passes does not establish restoration after ablation. Later components can oppose earlier contributions to the residual stream.",
      "placement": "V2",
      "source_count": 6,
      "examples": [
