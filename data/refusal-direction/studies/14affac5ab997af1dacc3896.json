          "r11",
          "r12"
        ]
      },
      {
        "finding": "Refusal-prefix variants of coding and translation queries route like their originals (JSD 0.0098, 0.0346). Cross-task pairs diverge far more (0.34–0.71).",
        "proposed_claim": "MoE routing tracks task semantics more than refusal-inducing response mode.",
        "row_ids": [
          "r13",
          "r14",
          "r15",
          "r16",
          "r17",
          "r18"
        ]
      },
      {
        "finding": "Matched harmful/benign rewrites have lower router JSD (0.1006) than random harmful (0.2362) or benign (0.2282) pairs.",
        "proposed_claim": "Changing safety intent under matched semantics shifts MoE routing less than changing topic.",
