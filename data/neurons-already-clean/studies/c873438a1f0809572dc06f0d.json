  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "cites_only",
    "tranche": "T6",
    "tranche_reason": "The study evaluates neuron descriptions in vision models, but does not measure the claim’s language-model findings or the specific versions listed.",
    "gate_note": "The study reports predictive evaluations of vision-neuron descriptions, which are related to neuron interpretability but do not test the listed claims about language models, neuron-pole shares, or the specified examples and methods.",
    "test_reason": "The study presents MAIA, an agent that writes descriptions of vision-model neurons, and scores those descriptions against baselines (MILAN, CLIP-Dissect, human experts). It reports no share of neurons with one or several jobs, no language-model neurons, nothing on InceptionV1 or circuit units, and no simulation-based scoring of explanations. Its tie to the claim is citing Bills et al. (an original source) in related work. The predictive-evaluation numbers compare description methods. They are not a rate of neuron interpretability.",
    "authors_conclusion": "Correct. The authors conclude MAIA's descriptions of vision neurons predict behaviour better than MILAN and are often on par with human experts. They also find MAIA useful for removing spurious features and surfacing classifier biases. Human oversight is still needed because of confirmation bias and tool failures.",
    "recipe": "different",
    "recipe_differences": "This study uses an iterative GPT-4V agent and image-based experiments to describe neurons in vision models; it does not use the language-model neuron methods or measure the pole shares in the claim.",
    "method_sensitivity": "Description evaluation results vary by vision architecture and layer. The authors also report that tool choices, including the image-generation model and access to dataset exemplars, affect performance.",
    "fits_no_version": [
      {
        "finding": "In ResNet-152, DINO-ViT and CLIP-RN50, descriptions from interactive experimentation (MAIA, human experts) give higher mean activation on generated positive images than exemplar-only MILAN labels. Neutral activations are similar across methods.",
        "proposed_claim": "In vision models, neuron descriptions built through interactive experimentation predict activation on new generated images better than descriptions of top-activating exemplars alone; the size of the gap varies by model and layer.",
        "row_ids": [
          "r1",
          "r2",
