  "page_placements": [],
  "record": {
    "read_status": "full",
    "file_problem": "none; the full paper text is present.",
    "relation": "uses_without_test",
    "tranche": "T4",
    "tranche_reason": "The study reports residual-memorization signatures after unlearning and argues that forgetting is structured rather than binary. It does not test whether the targeted knowledge can be recovered by the attacks in the claim.",
    "gate_note": "The experiments evaluate whether REMIND's loss-landscape features distinguish retained, forgotten, and holdout examples. They do not measure post-unlearning targeted-knowledge accuracy, fine-tuning recovery, activation ablation, quantization, or prompting recovery. The reported classifier scores and loss-landscape differences are therefore findings about residual-memorization indicators, not direct results for versions A–F.",
    "test_reason": "The study proposes REMIND, a black-box detector that classifies examples as retained, forgotten or holdout from loss over perturbed inputs. It reports only the detector's AUC against other detectors. It never measures targeted-knowledge accuracy, general ability, or recovery of forgotten knowledge by fine-tuning, internal edits, quantization or prompting. Paraphrased inputs are fed to the classifier, not used to elicit the forgotten knowledge. It is a detection study that relies on the residual-memorization idea without measuring how much knowledge survives, so it does not test versions A–F.",
    "authors_conclusion": "Mostly correct. The authors conclude that unlearning reshapes input loss landscapes and that forgetting is intermediate rather than binary. They also conclude that REMIND outperforms pointwise and neighborhood baselines at flagging unlearning failures, robustly across models, datasets and paraphrases. They add a preliminary observation: the loss increase on forgotten samples appears bounded by the maximum holdout loss. They do not show that forgotten knowledge can be recovered.",
    "recipe": "none",
    "recipe_differences": "REMIND is a black-box evaluation method, not an unlearning or recovery recipe.",
    "method_sensitivity": "Paraphrased versus original inputs changed the reported aggregate classifier scores.",
    "fits_no_version": [
      {
        "finding": "Forgotten examples show flatter, lower-variance input loss landscapes than retained or holdout examples. A classifier on these features separates the three classes (aggregate multi-class AUC about 82–83 on original inputs, about 74–75 on paraphrases).",
        "proposed_claim": "Unlearning leaves black-box-detectable residual-memorization signatures in the loss over semantically similar inputs, even when pointwise loss overlaps.",
