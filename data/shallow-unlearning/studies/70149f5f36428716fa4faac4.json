  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "tests",
    "tranche": "T1",
    "tranche_reason": "The paper tests whether its approximate-unlearning method reduces targeted Harry Potter familiarity while preserving general benchmark performance. It does not test the claim's recovery attacks.",
    "gate_note": "The paper reports familiarity scores, benchmark scores, and example completions after unlearning. It does not apply fine-tuning recovery attacks, activation-direction ablation, quantization, or prompt-rephrasing/jailbreak recovery. The individual token-probability plots are reported, but are not recovery attacks.",
    "test_reason": "This is an original source for version A. It introduces the approximate-unlearning method and measures Harry Potter familiarity and general benchmarks on Llama2-7b-chat, so it defines the A claim rather than testing it independently. Under the rules no verdict labels are given. It applies no recovery attacks (B–E) and proposes no attack-resistant method (F).",
    "authors_conclusion": "Broadly correct. The authors claim about 1 GPU-hour of fine-tuning effectively erases Llama2-7b's ability to generate or recall Harry Potter content, with benchmarks almost unaffected. They acknowledge a few Wikipedia-level leaks and say prompt-based evaluation may miss adversarial extraction. They open-sourced the model for community adversarial testing and caution that non-fiction content may not unlearn as well.",
    "recipe": "same",
    "recipe_differences": "The paper evaluates its own approximate-unlearning recipe: reinforced predictions combined with anchored-term translations, followed by fine-tuning on generic prediction labels. It does not compare against recovery-attack recipes.",
    "method_sensitivity": "The reported familiarity scores vary with fine-tuning steps; the completion-based score falls from 0.290 at 0 steps to 0.007 at 80, 100, and 120 steps, while probability-based familiarity falls from 0.244 to 0.006 by 120 steps.",
    "fits_no_version": [],
    "controls": "y",
    "capability_check": "y",
    "uncertainty_reported": "n",
    "code_released": "not stated",
    "peer_reviewed": "preprint",
    "problems": "The authors note that their prompt-based evaluation may miss adversarial extraction, report a small number of remaining leaks, did not have access to the original training data, and used an unlearn target that omitted some Harry Potter-related material. No uncertainty estimates are given for the reported scores.",
    "rows_left_out": "The intermediate fine-tuning-step values for the seven common benchmarks in Figure 5 are omitted to stay within the row limit; endpoint values at 120 steps and all familiarity-score steps are retained. Individual next-token probability tables and other example completions in Figures 1 and 3, and Figures 7–10 and Appendix Figure 6, are also not separately extracted.",
    "untested": [
      {
        "version": "A",
        "parts": "Whether simple attacks (fine-tuning, rephrasing, probing) recover the knowledge. Also targeted-knowledge accuracy against a chance level: the familiarity scores have no chance level."
      },
      {
        "version": "B",
        "parts": "All: no relearning or fine-tuning recovery attack. The authors only speculate that collateral forgetting can be undone by fine-tuning on related content."
      },
      {
        "version": "C",
        "parts": "All: no activation-direction ablation or mechanistic analysis."
      },
      {
        "version": "D",
        "parts": "All: no quantization."
      },
      {
        "version": "E",
        "parts": "All: no jailbreaks, other languages or in-context recovery. The curated prompts are the standard evaluation, not an attack."
      },
      {
        "version": "F",
        "parts": "All."
      }
    ],
    "missing": [
      {
        "what": "Ablation: reinforcement bootstrapping alone never cut completion familiarity by more than a factor of 0.3. Anchored terms alone matched the familiarity score only with lower benchmarks (ARC-c 0.40, HellaSwag 0.54, WinoGrande 0.61).",
        "locator": "Section 4.1 Ablation study",
        "versions": "A"
      },
      {
        "what": "Phi-1.5 (1.3B) with the unlearn target added to its training data; results described only as qualitatively similar, with no numbers.",
        "locator": "Section 4 Results, first paragraph",
        "versions": "A"
      },
      {
        "what": "Per-prompt next-token probability dynamics showing residual Harry Potter tokens at 120 steps (e.g. 'fore' still 0.19 for the scar prompt).",
        "locator": "Figures 3, 7–10",
        "versions": "A"
      }
    ],
    "verdict_notes": "This paper is an original source for version A, so no verdict labels are given. Rows r1–r2 are controls, not results. For r5–r14, 'observed' means familiarity fell to near zero relative to the pre-unlearning score; the score has no chance level. Leak rows r22–r23 show residual knowledge, the kind later attack papers build on. Figure 2 reports a different fine-tuned checkpoint (e.g. ARC-C 0.416, WinoGrande 0.665) than the 120-step column of Figure 5."
  },
