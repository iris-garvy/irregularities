  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "tests",
    "tranche": "T3",
    "tranche_reason": "The study evaluates unlearning with knowledge-accuracy and general-ability measures on a new benchmark, but does not run the recovery attacks described in the claim.",
    "gate_note": "The study reports unlearning outcomes for knowledge accuracy, MMLU utility, and membership-inference attack rates. It does not test recovery by fine-tuning, activation-direction ablation, quantization, or prompt rephrasing. MIA measures membership inference, not recovery of targeted knowledge.",
    "test_reason": "On a new benchmark (LUME: synthetic stories, synthetic PII biographies, real biographies), the study measures forget-set knowledge accuracy, retain-set accuracy and MMLU after GA, GD, KL and NPO unlearning of OLMo-7B. This bears on Version A's claim that targeted knowledge reaches near chance while general ability is kept. It runs no recovery attacks (fine-tuning, ablation, quantization, prompting), so B–F are untested.",
    "authors_conclusion": "Mostly correct. The authors conclude that most algorithms fail to unlearn the forget set without substantial degradation on the retain set and MMLU utility. They also say NPO's persistently high MIA success suggests it does not truly remove the information. That last point is an inference from MIA, not a recovery test.",
    "recipe": "different",
    "recipe_differences": "The study tests GA, GD, KL, and NPO on its own LUME tasks and OLMo checkpoints; it does not apply the recovery-attack recipes in the claim.",
    "method_sensitivity": "Unlearning outcomes vary across the three tasks; GD membership-inference rates fall below chance after epoch 7.",
    "fits_no_version": [
      {
        "finding": "Loss-based MIA AUC falls to about 0.5 for GA and KL and below 0.5 for GD after epoch 7, but stays high for NPO after 10 epochs.",
        "proposed_claim": "Membership-inference leakage after unlearning depends on the algorithm; NPO leaves a detectable membership signal. This does not itself show the knowledge can be recovered.",
        "row_ids": [
          "MIA-GA",
          "MIA-GD",
          "MIA-KL",
          "MIA-NPO"
        ]
      }
    ],
    "controls": "n",
    "capability_check": "y",
    "uncertainty_reported": "n",
    "code_released": "github.com/amazon-science/lume-llm-unlearning",
    "peer_reviewed": "Conference on Empirical Methods in Natural Language Processing",
    "problems": "Detailed results are presented only for the 7B model due to space limitations. The plotted values are not numerically transcribed in the text, and the study does not test recovery attacks.",
    "rows_left_out": "Regurgitation-rate results in Figure 2 are omitted; the knowledge-accuracy rows capture the targeted-knowledge outcome, while the MMLU rows capture general utility.",
    "untested": [
      {
        "version": "A",
        "parts": "Whether simple attacks fail to recover the knowledge. No attack is run. The 1B model's results are not shown."
      },
      {
