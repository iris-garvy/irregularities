    ],
    "controls": "n",
    "capability_check": "y",
    "uncertainty_reported": "y",
    "code_released": "https://gitlab.inria.fr/almanach/CamemBERTa",
    "peer_reviewed": "Annual Meeting of the Association for Computational Linguistics, 2023",
    "problems": "Only two token amounts are compared for the relevant MLM model pair; the study does not fit or assess a scaling curve or report held-out pretraining loss. Downstream task results are not a direct test of predictive accuracy from a fitted scaling law.",
    "rows_left_out": "No relevant paired CamemBERT30%/CamemBERTCCNet task results were left out. Other model comparisons are not recorded as scale rows because they also vary architecture, objective, dataset, or originate from cited work.",
    "untested": [],
    "missing": [],
    "verdict_notes": "The paper is about data efficiency from architecture and objective, not scaling laws. Each paired comparison was recorded twice (once per model); the odd rows suffice. No scaling fits, no loss curves, and no more than two training durations for any same-architecture model. The Table 4 comparisons against mDeBERTa and XLM-R use cited results and vary everything, so they are rightly excluded."
  },
