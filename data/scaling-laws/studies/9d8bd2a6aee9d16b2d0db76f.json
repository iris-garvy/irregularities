    "title": "Data-Efficient French Language Modeling with CamemBERTa",
    "citation": "Wissam Antoun et al., 2023",
    "url": "https://arxiv.org/abs/2306.01497",
    "authors": "Wissam Antoun; Benoît Sagot; Djamé Seddah",
