        ]
      },
      {
        "finding": "During fine-tuning, FlanT5 3B math performance plateaus at about 90K examples while Base keeps improving through 3 epochs (Fig. 3). The authors call smaller models more data-hungry.",
        "proposed_claim": "Larger models reach fine-tuning plateaus with fewer examples.",
        "row_ids": []
      }
    ],
    "controls": "y",
    "capability_check": "n",
