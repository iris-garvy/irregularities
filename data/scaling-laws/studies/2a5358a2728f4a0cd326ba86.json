  "record": {
    "read_status": "full",
    "file_problem": "none; the full paper text is present.",
    "relation": "tests",
    "tranche": "T3",
    "tranche_reason": "Tests the downstream-performance version of the claim in a biomedical term-normalization setting, reporting task accuracy for models of different scales.",
    "gate_note": "The paper cites scaling-law work and discusses scale effects, but does not measure held-out pretraining cross-entropy, fit power laws, test extrapolation, or compare compute-optimal allocations. Its own baseline model accuracy results bear on V6. The cited scaling-law results are not this study's results.",
    "test_reason": "Its own Table 3 compares unmodified Llama 3.1 8B and 70B (plus GPT-4o) on biomedical term-to-identifier mapping accuracy. This bears weakly on V6 (downstream improves with scale) in a new domain. There is only one within-family scale step and no curve, loss or prediction.",
    "authors_conclusion": "The record's paraphrase is largely right. The authors state that larger models 'consistently outperformed smaller ones' (GPT-4o > 70B > 8B) and that fine-tuning the 8B model did not close the gap, which they attribute to scaling laws. Note that their 'consistently' is contradicted by the HPO ID→term tie at 0.0%. Their main conclusions concern identifier popularity and lexicalization driving fine-tuning memorization and generalization, not scale.",
    "recipe": "different",
    "recipe_differences": "The study compares baseline task accuracy across pretrained models and fine-tunes Llama 3.1 8B with LoRA; it does not perform a parameter/token/compute sweep or fit loss scaling curves.",
    "method_sensitivity": "Accuracy varies by terminology and mapping direction; the HPO identifier-to-term result is tied at 0.0% for the 8B and 70B baselines.",
    "fits_no_version": [
      {
        "finding": "Mapping accuracy tracks a proxy for pretraining exposure: identifier frequency in PubMed Central is higher for correctly mapped identifiers and orders as GENE > GO > HPO.",
        "proposed_claim": "Downstream factual recall depends on how often the fact appears in pretraining data (fact popularity), separately from model scale.",
        "row_ids": []
      }
    ],
    "controls": "y",
    "capability_check": "y",
    "uncertainty_reported": "y",
    "code_released": "https://github.com/clslabMSU",
    "peer_reviewed": "Frontiers in Digital Health",
    "problems": "The scale comparison uses three named baseline models, but GPT-4o's parameter count is not stated. Accuracy results have no reported uncertainty, and the study does not fit or test quantitative downstream scaling predictions.",
    "rows_left_out": "Fine-tuned Llama 3.1 8B accuracy values in Table 3 and the train/validation memorization and generalization category results in Tables 4–5 were not extracted as rows: they measure fine-tuning outcomes, not performance as a function of model scale or pretraining loss.",
    "untested": [
