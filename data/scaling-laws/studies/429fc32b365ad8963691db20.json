  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "tests",
    "tranche": "T3",
    "tranche_reason": "Tests model-size effects on held-out language-modeling perplexity and downstream performance in multilingual GPT models, extending the scaling question to this setting.",
    "gate_note": "The paper compares mGPT1.3B and mGPT13B and reports held-out perplexity, corpus-size correlation tests, and downstream scores. It does not fit power laws, test extrapolation, or identify compute-optimal allocations. Architecture descriptions and cited scaling-law results are not study results.",
    "test_reason": "The study's own results compare held-out perplexity and downstream scores for two mGPT sizes (1.3B and 13B), both trained on the same 400B tokens. This bears on the direction of V1 and V6 in a multilingual setting. It fits no scaling law, so the test is weak: two points about one order of magnitude apart.",
    "authors_conclusion": "Mostly right but softened. The authors state that scaling improves language modeling for all languages but 'does not improve performance on the downstream and probing tasks'. They add that language-modeling performance depends on model size and per-language corpus size, and that smaller models may encode linguistic information better. Their own Table 7 shows 13B gains on most classification tasks, so the 'no improvement' statement holds mainly for sequence labeling and low-resource probing.",
    "recipe": "different",
    "recipe_differences": "Multilingual GPT-style models are compared at two parameter counts using held-out perplexity and downstream evaluations; the study does not fit scaling laws or predict larger runs.",
    "method_sensitivity": "Downstream outcomes vary by task and number of demonstrations; the paper also reports prompt sensitivity for hate-speech detection.",
    "fits_no_version": [
      {
        "finding": "Across languages, per-language perplexity is (non-significantly) associated with document count in the pretraining corpus (p=0.137 and p=0.307). The authors describe a positive correlation and attribute it to low domain diversity in low-resource corpora.",
        "proposed_claim": "In multilingual pretraining, per-language held-out loss tracks that language's share of the pretraining data.",
        "row_ids": [
          "R02",
          "R03"
        ]
      }
    ],
    "controls": "y",
    "capability_check": "y",
    "uncertainty_reported": "n",
    "code_released": "github.com/ai-forever/mgpt",
    "peer_reviewed": "Transactions of the Association for Computational Linguistics",
    "problems": "Only two model sizes are used for the language-modeling size comparison, and no scaling-law fit is reported. Numerical held-out perplexity values are presented in figures rather than transcribed in the text. Downstream results mostly provide point scores; uncertainty estimates are not reported.",
    "rows_left_out": "Table 7 XGLM baseline scores are omitted because the rows focus on the mGPT size comparison. The tokenization-strategy ablation (Table 3) does not test a claim version. Detailed per-language NER/POS and probing values are not added beyond the separately stated scale comparisons.",
    "untested": [
      {
        "version": "V1",
        "parts": "Power-law form, the multi-order-of-magnitude range, scaling in tokens or compute (both sizes saw 400B tokens); only the direction of the size effect is shown."
      },
      {
        "version": "V2",
        "parts": "All; no small-run fit is used to predict larger runs."
      },
      {
        "version": "V3",
        "parts": "All; no fixed-compute allocation study."
      },
      {
        "version": "V4",
        "parts": "All; no shape ablation at fixed parameter count (the tokenizer ablation is not architecture shape)."
      },
      {
        "version": "V5",
        "parts": "All; continued monolingual pretraining (Table 12) reports single perplexities with no scaling."
      },
      {
        "version": "V6",
        "parts": "Predictability (any fitted relation of downstream score to scale or loss); only two sizes are compared."
      },
      {
        "version": "V7",
        "parts": "All."
      }
    ],
    "missing": [
      {
        "what": "Mann-Whitney U test of the model-size effect on per-language perplexity, p=0.0007. This is the only significance test of the 1.3B vs 13B loss difference.",
        "locator": "§4.1, Table 5 (Model size row)",
        "versions": "V1"
      }
    ],
    "verdict_notes": "This is a model-release paper, not a scaling study. Both sizes were trained on the same 400B tokens with GPT-3 shapes, so the comparison confounds parameters with shape and gives no compute or token axis. Downstream differences carry no uncertainty estimates even though few-shot runs used five seeds. Several tasks (PAWSX, hate speech, XNLI 16-shot) sit near chance, which makes small differences uninformative. Not one of the original sources."
  },
  "versions": [
    {
      "version": "V1",
      "status": "tested",
      "untested_parts": "Only two model sizes are compared; there is no power-law fit or evidence over several orders of magnitude. The relation to training-token count is examined through document-count correlations, not a controlled token-count sweep; compute scaling is not tested."
    },
    {
      "version": "V2",
      "status": "not_tested",
      "untested_parts": "No small-run fit is used to predict larger-run losses."
    },
    {
      "version": "V3",
      "status": "not_tested",
      "untested_parts": "No fixed-compute budget sweep or optimal parameter/token allocation is tested."
    },
    {
      "version": "V4",
      "status": "not_tested",
      "untested_parts": "No controlled comparison of depth, width, or architecture at fixed parameter count."
    },
    {
      "version": "V5",
      "status": "not_tested",
      "untested_parts": "The study is text pretraining. It reports continued monolingual pretraining, but does not test whether a power-law form holds in that regime or in other modalities, repeated-data training, fine-tuning, or transfer."
    },
    {
      "version": "V6",
      "status": "tested",
      "untested_parts": "Downstream scores are compared for two model sizes, but the study does not fit a predictive relationship between downstream performance and pretraining loss or scale."
    },
    {
      "version": "V7",
      "status": "not_tested",
      "untested_parts": "No comparison of scaling-law exponents, fitting choices, or curve shapes."
    }
