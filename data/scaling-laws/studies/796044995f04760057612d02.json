        ]
      },
      {
        "finding": "An LLM-extracted count gives 32 knowledge elements per Pair-Caption-v2 sample versus 22 for standard caption/VQA data.",
        "proposed_claim": "Paired-image captions carry more extracted semantic elements per sample.",
        "row_ids": [
          "r21"
        ]
      }
    ],
    "controls": "y",
