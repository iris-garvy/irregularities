      },
      {
        "finding": "Intermediate checkpoints of a cosine run overestimate loss relative to a cosine run matched to that length. Loss at a given token count depends on whether the schedule is matched to the training length (Figs 1, 3).",
        "proposed_claim": "Measured loss at fixed (N, D) depends on learning-rate schedule length, which matters for how scaling-law data points are collected.",
        "row_ids": []
      }
    ],
    "controls": "y",
    "capability_check": "n",
    "uncertainty_reported": "n",
    "code_released": "https://github.com/epfml/schedules-and-scaling/",
    "peer_reviewed": "NeurIPS 2024",
    "problems": "The scaling-sweep values are shown in figures rather than tabulated, and the study does not fit power laws or report uncertainty for those curves. Its largest scaling-law sweep covers 33M–360M models and 0.3B–10.2B tokens.",
    "rows_left_out": "No separate rows for cosine or SWA schedule-comparison points: those comparisons test schedule performance, not an additional claim version. Downstream benchmark schedule comparisons are also omitted because they do not test predictability from scale or pretraining loss.",
    "untested": [
      {
        "version": "V1",
        "parts": "No power-law fit or exponents. The loss envelope versus FLOPs for 33M–360M models (about 1e16–1e19 FLOPs) is shown but not fitted."
      },
      {
        "version": "V2",
        "parts": "No extrapolation from small runs to larger runs."
      },
      {
        "version": "V3",
        "parts": "No compute-optimal N/D allocation is estimated."
      },
      {
        "version": "V4",
        "parts": "No shape comparison at fixed parameter count."
      },
      {
        "version": "V5",
        "parts": "Text pretraining only; OpenWebText2 is another text corpus."
      },
      {
        "version": "V6",
        "parts": "Downstream scores are compared across schedules at 1B scale, not against scale or loss."
      },
      {
        "version": "V7",
        "parts": "No fitted exponents or optimal splits are compared across schedules. Schedule effects are shown only on raw loss."
      }
    ],
    "missing": [],
    "verdict_notes": "Relation changed from tests/T2 to uses_without_test/T4. The scaling sweep exists to show that the authors' schedule substitutes for cosine when gathering scaling-law data, not to test the power-law claim. The cited concurrent work (Porian et al.; Pearce & Song) on the Kaplan–Chinchilla discrepancy is not the paper's own result."
  },
