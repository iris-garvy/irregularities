  "page_placements": [],
  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "uses_without_test",
    "tranche": "T4",
    "tranche_reason": "Applies autoregressive scaling to image generation and reports results across model sizes, but does not test the claimed language-model loss laws or compute-optimal allocation.",
    "gate_note": "The paper cites language-model scaling work and evaluates image-generation FID across model sizes. FID is not held-out pretraining cross-entropy, and the paper does not fit power laws or test compute-optimal parameter/token allocation. The image FID results are recorded as related findings under fits_no_version, not as tests of a claim version.",
    "test_reason": "LlamaGen trains autoregressive image-token models from 111M to 3.1B parameters and reports ImageNet FID per size (Table 5, Fig. 2, Tables 8–10). It never reports held-out cross-entropy loss, fits no power law, does no extrapolation, and varies neither tokens nor compute allocation. FID is a sample-quality metric for its own method, not the loss whose power-law form V5 names. Scaling-law work is cited only as motivation, so this is T4 rather than the record's T3; T3 would require a result on the claim.",
    "authors_conclusion": "The paraphrase is correct. Vanilla Llama-style autoregressive models, scaled properly, are competitive image generators that beat LDM and DiT on ImageNet. The 2.18 FID is LlamaGen-3B at 384px, 300 epochs, cfg 1.65. The authors make no claim about loss power laws.",
    "recipe": "different",
    "recipe_differences": "Uses autoregressive image-token generation and ImageNet FID, rather than language-model pretraining and held-out cross-entropy; no power-law fitting or compute-optimal allocation. The paper releases implementation code.",
    "method_sensitivity": "Image-token count, classifier-free guidance scale, sampling settings, and training epochs affect reported image-generation metrics.",
    "fits_no_version": [
      {
        "finding": "On class-conditional ImageNet after 50 epochs (cfg 1.75), FID falls with model size from 111M to 3.1B. With 256 tokens it goes 8.69→4.21→3.39→3.09→3.06; with 576 tokens it goes 12.89→5.01→3.42→2.89→2.61. Gains flatten at 3B, especially with 256 tokens. The authors call this marginal and attribute it to ImageNet's ~1M images. Below 1B parameters, 256 tokens beat 576 tokens.",
        "proposed_claim": "Autoregressive image-generation quality (FID) improves with parameter count with diminishing returns, and the size of the gain depends on tokenization and dataset size.",
        "row_ids": [
          "r1",
          "r2",
          "r3",
          "r4",
          "r5",
          "r6",
          "r7",
          "r8",
          "r9",
          "r10"
        ]
      }
    ],
    "controls": "n",
    "capability_check": "y",
    "uncertainty_reported": "n",
    "code_released": "https://github.com/FoundationVision/LlamaGen",
    "peer_reviewed": "preprint",
    "problems": "The relevant scaling results use image-generation FID rather than held-out cross-entropy. No power law is fitted, no extrapolation is evaluated, and training-token or compute-optimal allocations are not compared. The paper notes that ImageNet has approximately only 1 million images and suggests dataset size may limit further gains. No uncertainty estimates are stated for the FID results.",
    "rows_left_out": "Tables 6 and 8–10 report further FID results across model sizes, epochs, and classifier-free guidance settings. They are not itemized here because they are additional image-generation FID comparisons rather than measurements of any claim version; Table 5 supplies the paper's direct, fixed-epoch model-size sweep.",
    "untested": [
