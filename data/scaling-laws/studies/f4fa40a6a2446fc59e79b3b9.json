  "record": {
    "read_status": "full",
    "file_problem": "none",
    "relation": "tests",
    "tranche": "T3",
    "tranche_reason": "The study compares evaluation performance across model sizes, but does not measure the held-out cross-entropy losses or compute-optimal allocations in the original scaling-law studies.",
    "gate_note": "The study reports automatic dialogue-generation metrics for three EVA2.0 sizes, which bear on V6. Its other experiments compare data filtering, architecture, pre-training approaches, and decoding strategies, but do not report held-out pre-training loss or test the other claim versions.",
    "test_reason": "A dialogue-model release paper, not a scaling study. Table 10 reports automatic response-generation metrics for three same-recipe EVA2.0 sizes (300M, 970M, 2.8B), giving a weak, three-point, unfitted check of V6 in a new setting: Chinese encoder-decoder dialogue models. T3 fits better than T2 because the study does not aim at the scaling question.",
    "authors_conclusion": "Mostly correct. The authors conclude that EVA2.0 2.8B significantly outperforms open-source Chinese dialogue baselines in automatic and human evaluation. They note the 300M variant matches the 2.8B EVA1.0, which they credit to careful data refinement rather than scale. They draw no scaling-law conclusion.",
    "recipe": "different",
    "recipe_differences": "The study compares dialogue-generation metrics across three sizes of Chinese dialogue models; it does not use held-out pre-training cross-entropy or the original studies' scaling-law fitting procedure.",
    "method_sensitivity": "",
    "fits_no_version": [
      {
        "finding": "At a fixed 300M parameters, changing the encoder/decoder layer split (6-18, 18-6, 12-12) shifts downstream F1 from 15.5 to 16.2 and D-4 from 49.4 to 53.4 on Single (Table 5). The balanced split is best. Measured on downstream metrics, not loss.",
        "proposed_claim": "Encoder-decoder layer allocation at fixed parameter count modestly affects downstream dialogue metrics.",
        "row_ids": []
      },
      {
        "finding": "The 300M EVA2.0, trained on a smaller filtered dataset, matches or beats the 2.8B EVA1.0, trained on 3x more unfiltered data, on automatic metrics (Table 10).",
        "proposed_claim": "Data quality can substitute for roughly 9x parameters on downstream dialogue metrics.",
        "row_ids": []
      }
    ],
    "controls": "n",
    "capability_check": "y",
    "uncertainty_reported": "n",
    "code_released": "not stated",
    "peer_reviewed": "Machine Intelligence Research",
    "problems": "The size comparison includes only three EVA2.0 models and reports response-generation metrics rather than held-out pre-training loss. No uncertainty estimates or controls are reported for this comparison, and the study does not fit or test predictive scaling curves.",
    "rows_left_out": "No relevant Table 10 EVA2.0 size-comparison rows were left out. Other table results concern baselines, decoding, architecture, or pre-training choices rather than the claim versions tested here.",
    "untested": [
      {
        "version": "V6",
        "parts": "No fitted or extrapolated predictive relationship. No link between downstream metrics and pretraining loss. Only three sizes, all under 3B. Only automatic overlap and diversity metrics; human evaluation covers the 2.8B model only. No uncertainty estimates."
      },
      {
        "version": "V1",
        "parts": "No held-out pretraining loss is reported across sizes."
      },
      {
        "version": "V2",
        "parts": "Not addressed."
      },
      {
        "version": "V3",
        "parts": "Not addressed. All sizes use the same data; training time is 30 days for all, on 64 vs 32 GPUs."
      },
      {
        "version": "V4",
        "parts": "Not addressed with loss (see fits_no_version)."
      },
      {
        "version": "V5",
        "parts": "Not addressed."
      },
      {
        "version": "V7",
        "parts": "Not addressed."
      }
    ],
    "missing": [],
    "verdict_notes": "The size comparison confounds compute: per Appendix B, xLarge trained on 64 GPUs and the smaller models on 32, all for 30 days. Decoding uses beam search plus sampling, which affects D-4. No variance across seeds is reported. The evidence for V6 is weak."
  },
