        ]
      },
      {
        "finding": "COSMOS-12B at N=1 has a better nuScenes FVD (560.86) than COSMOS-4B even at N=16 (599.08). The authors' claim that small models match larger ones rests mainly on FID, other metrics, and human preference.",
        "proposed_claim": "Test-time compute on a smaller video model can partly substitute for model size at matched inference FLOPs, depending on the metric.",
        "row_ids": [
          "r17",
          "r19"
        ]
      }
