    ],
    "controls": "n",
    "capability_check": "y",
    "uncertainty_reported": "y",
    "code_released": "https://github.com/rohitsinghlab/plm_reverse_distillation",
    "peer_reviewed": "ICLR 2026 conference paper",
    "problems": "No held-out pretraining-loss or compute-optimal-allocation measurements; no extrapolation test; Table 4 gives no uncertainty estimates. The paper reports downstream scores on a limited set of tasks, which do not by themselves establish a general scaling law.",
    "rows_left_out": "Tables 1-3 and Appendix Figures 3-4 contain additional DMS results, chain configurations, and method comparisons. They were not extracted because these additional separately reported model/configuration outcomes, together with Table 4, would exceed the 60-row limit; Table 4 was retained as the clearest task-by-model downstream scaling evaluation.",
    "untested": [
      {
        "version": "V6",
        "parts": "Predictability: no fit or extrapolation of downstream performance from scale or from pretraining loss. Only three to six discrete sizes of one model family, probed linearly."
      }
    ],
    "missing": [
      {
        "what": "Baseline ESM-2 mean ProteinGym DMS Spearman by size. Mostly rising: 1-mut (28 datasets) 0.879, 0.881, 0.899. 4-mut 0.555, 0.552, 0.566 (650M, 3B, 15B).",
        "locator": "Table 3",
        "versions": "V6"
      },
      {
        "what": "Percentage of DMS datasets where the larger baseline beats the smaller. 15B>3B: 53.57% (1-mut), 46.43% (2-mut). 3B>650M: 16.67% on the >2-mutation set.",
        "locator": "Table 2",
        "versions": "V6"
      },
      {
        "what": "Baseline ESM-2 8M to 3B on three DMS datasets is non-monotonic, e.g. ILF3: 150M 0.760 vs 650M 0.712.",
        "locator": "Table 1",
        "versions": "V6"
      }
    ],
    "verdict_notes": "V1 to V5 and V7 are not tested: no pretraining loss, fits, or allocation are measured. The paper does not report cross-entropy, so the protein-LM setting does not bear on V5. Only the baseline ESM-2 rows count toward V6. The 650M reference rows (r1, r7, r13, r19, r25) are kept as baselines."
