  "record": {
    "read_status": "full",
    "file_problem": "None; the full paper text is present.",
    "relation": "tests",
    "tranche": "T3",
    "tranche_reason": "Tests scaling with cohort size in physiological heartbeat sequences, a new domain relative to language-model scaling.",
    "gate_note": "The study reports fitted scaling laws for five metrics and projections to larger cohorts. The projections are derived from the fitted curves; the study does not evaluate actual models trained on those larger cohorts.",
    "test_reason": "The study fits metric(n) = E + A n^-α to held-out metrics of a GRU neural temporal point process. Training cohorts run from 1 to 183 subjects, with 10 seeds at each of 12 sizes. This bears on V5: whether the power-law form holds beyond text pretraining, here in physiological heartbeat-sequence modelling, scaling in data only.",
    "authors_conclusion": "Mostly right, with one correction. The authors say point-accuracy metrics make performance look near-saturated at n=183, which they call misleading. They argue KS distance and goodness-of-fit keep improving to 10,000 subjects, an improvement that exists only in extrapolation from the fitted laws. They conclude that data budgets in stochastic domains should be guided by distributional calibration.",
    "recipe": "different",
    "recipe_differences": "Fits a cohort-size law for a neural temporal point process on heartbeat data, using metric(n) = E + A n−α and robust Huber loss; it does not sweep language-model parameters, tokens, or compute.",
    "method_sensitivity": "",
    "fits_no_version": [],
    "controls": "n",
    "capability_check": "y",
    "uncertainty_reported": "y",
    "code_released": "not stated",
    "peer_reviewed": "preprint",
    "problems": "The largest training cohort is 183 subjects, while projections extend to 10,000 subjects and beyond without evaluation at those sizes. MAE and RMSE fits are described as noisy; goodness-of-fit has an imposed 100% ceiling.",
    "rows_left_out": "None.",
    "untested": [
      {
        "version": "V1",
        "parts": "Language-model pretraining loss versus parameters, tokens or compute."
      },
      {
        "version": "V2",
        "parts": "No runs beyond 183 subjects; projections to 1,000 and 10,000 subjects are never checked against trained models."
      },
      {
        "version": "V3",
        "parts": "Compute-optimal allocation; model size is neither varied nor reported."
      },
      {
        "version": "V4",
        "parts": "Architecture shape at fixed parameter count."
      },
      {
        "version": "V5",
        "parts": "Parameter or compute scaling in this domain, and other modalities or regimes (image, video, repeated data, fine-tuning, transfer). Only data (cohort-size) scaling over about two orders of magnitude is tested."
      },
      {
        "version": "V6",
        "parts": "Downstream task performance."
      },
      {
        "version": "V7",
