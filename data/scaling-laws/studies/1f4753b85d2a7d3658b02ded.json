  "record": {
    "read_status": "full",
    "file_problem": "Full paper text is present. Some figure and appendix text is garbled, but the relevant model results and values in Tables 2 and 3 are readable.",
    "relation": "tests",
    "tranche": "T3",
    "tranche_reason": "The study compares physical-concept task accuracy across OPT parameter counts, bearing on downstream performance versus scale, but it does not measure held-out cross-entropy or fit loss scaling laws.",
    "gate_note": "Rows cover the OPT size sweep on the eight VEC tasks, with accuracy reported separately by task and model size. Other model comparisons, human evaluations, few-shot results, image-representation case studies, and distillation results do not test downstream predictability from scale and are not included.",
    "test_reason": "It reports zero-shot downstream accuracy for OPT at 125M, 1.3B, 13B and 175B on eight new physical-concept tasks (Tables 2–3). That is a new setting with results on whether downstream performance improves with scale (V6). It measures no loss and fits no scaling law, so V1–V5 and V7 are untested. T3 fits better than T2: the method is not aimed at the scaling-law question itself.",
    "authors_conclusion": "Mostly correct. The authors say understanding of some visual concepts (color, size) emerges as OPT scales. They say the scaling law fails on Height and on embodied concepts (mass, temperature, hardness), where even OPT-175B performs poorly or near chance. They also find that vision-language models and distillation from them help embodied concepts more than scaling does.",
    "recipe": "different",
    "recipe_differences": "Measures VEC physical-concept accuracy across OPT parameter counts rather than held-out pretraining loss against parameters, tokens, or compute; no scaling-law fit is made.",
    "method_sensitivity": "The reported scaling outcome differs by VEC task: Color and Size improve across sizes, while Height and Mass do not; Shape, Material, Temperature, and Hardness are non-monotonic.",
    "fits_no_version": [],
    "controls": "n",
    "capability_check": "y",
    "uncertainty_reported": "y",
    "code_released": "https://github.com/TobiasLee/VEC",
    "peer_reviewed": "preprint",
    "problems": "The scale comparison is limited to four OPT sizes and VEC accuracy; no scaling fit, loss measure, tokens or compute sweep, or uncertainty analysis of the trend is reported. The paper itself notes limits in its physical-property coverage and in its selection of VLMs.",
    "rows_left_out": "No eligible OPT scaling-sweep rows were left out. Few-shot, distillation, human, scratch-trained, BERT/RoBERTa, and VLM results are not parameter-count scaling sweeps for the tested V6 comparison.",
    "untested": [
      {
        "version": "V6",
        "parts": "No downstream performance as a function of pretraining loss. No fitted curve or extrapolation from smaller models. No token or compute axis. Only four OPT sizes from one family, zero-shot perplexity-comparison probing."
      },
      {
        "version": "V1",
        "parts": "Entire version: no held-out loss measured."
      },
